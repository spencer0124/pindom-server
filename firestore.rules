rules_version = '2';

// PINDOM Firestore 보안 규칙
//
// 기준 문서: 앱 레포의 docs/reference/backend-contract.md "Write ownership" 표.
// 필드 이름이나 쓰기 주체가 어긋나면 그 문서가 심판이다.
//
// 원칙 세 가지:
//   1. 기본은 차단. 열 곳만 하나씩 연다 (파일 끝 catch-all).
//   2. 돈처럼 취급되는 값(ticketBalance·ticketsIssued·placesVisited·tier·각종 count)은
//      클라이언트가 절대 못 쓴다. 예외는 회원가입 때 0으로 박는 단 한 번뿐.
//   3. 규칙은 결과를 걸러주지 않는다. 목록 조회는 쿼리 자체가 안전할 때만 허용된다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 이번 쓰기가 실제로 건드리는 필드 집합.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 작성자 신원 대조. 가입 직후에는 tier 필드가 없다 — issueTicket 이 첫 티켓을 발행할 때
    // 처음 생긴다. 없는 키를 그냥 읽으면 평가가 예외로 끝나 거부되므로 기본값과 함께 읽는다.
    // club10 은 앱의 읽기 기본값이자 0–19 구간의 등급이라 양쪽과 맞는다.
    function authorMatchesMe() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && request.resource.data.authorId == request.auth.uid
             && request.resource.data.authorNickname == userDoc().nickname
             && request.resource.data.authorTier == userDoc().get('tier', 'club10');
    }

    // --- 시드 데이터 — 로그인하면 읽기, 쓰기는 백엔드만 -----------------------

    match /artists/{artistId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /raffles/{raffleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 게시판 목록. 관리 도구가 saveBoard 로만 쓴다 — 클라이언트가 만들 수 있으면
    // 아무나 게시판을 늘릴 수 있고, 앱의 탭 구성이 사용자 입력이 된다.
    match /boards/{boardId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /places/{placeId} {
      allow read: if signedIn();
      allow write: if false;

      // 갤러리는 issueTicket 이 쓴다. 클라이언트가 직접 올릴 수 있으면
      // "인증된 사람만 올린 사진 벽" 이라는 성질 자체가 사라진다.
      match /gallery/{photoId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // 리뷰는 앱이 자동 id 로 만든다. 규칙이 컬렉션을 조회할 수 없어 "이 사람이 여기
      // 다녀왔는가" 를 확인할 방법이 없다 — 문서 id 로 접근할 수 있는 것만 볼 수 있기
      // 때문이다. 작성자 신원과 배지만 대조한다.
      //
      // ponytail: 방문 검증 없음. 가본 적 없는 장소에도, 한 장소에 몇 개든 쓸 수 있다.
      // 막으려면 앱이 리뷰 문서 id 를 ticketId 로 쓰고 ticketId 를 필드로도 보내야 한다.
      // 그때 규칙은 get(tickets/$(ticketId)) 로 소유자와 장소를 확인하면 된다.
      // reviewShape() 은 create·update 양쪽이 쓴다 — 크기 상한이 한쪽에만 있으면
      // update 로 우회해 무제한 텍스트를 채워 넣을 수 있다.
      function reviewShape() {
        return request.resource.data.text is string
               && request.resource.data.text.size() <= 2000
               && (!('tags' in request.resource.data)
                   || (request.resource.data.tags is list
                       && request.resource.data.tags.size() <= 10));
      }

      match /reviews/{reviewId} {
        allow read: if signedIn();

        allow create: if authorMatchesMe()
                      && reviewShape()
                      && request.resource.data.likeCount == 0
                      && request.resource.data.createdAt == request.time;

        allow update: if isOwner(resource.data.authorId)
                      && changed().hasOnly(['text', 'tags'])
                      && reviewShape();

        allow delete: if isOwner(resource.data.authorId);
      }
    }

    // --- users — 본인 문서만 ------------------------------------------------

    match /users/{uid} {
      // 타인 문서는 열지 않는다. Firestore 는 필드 단위 읽기를 막을 수 없어
      // 문서를 열면 email 까지 따라 나오고, 타인 프로필 화면은 설계에 없다.
      // 피드·리뷰는 작성자 정보를 자기 문서에 비정규화해 들고 있다.
      allow get, list: if isOwner(uid);

      // 회원가입 직후 앱이 자기 문서를 만든다. 카운터 3개는 반드시 0.
      // tier 도 함수 전용이다. 카운터만 고정하고 두면 가입 요청에 tier: 'clubGo' 를 끼워
      // 넣을 수 있고, 그 뒤 리뷰·게시글의 등급 대조가 위조된 값을 기준으로 통과한다.
      //
      // AI·인증 일일 상한 카운터는 여기 없다 — rateLimits/{uid} 로 옮겼다. 클라이언트가
      // 만드는 문서에 서버 전용 필드를 두면 필드마다 "끼워 넣지 마" 를 적어야 하고, 새
      // 카운터가 생길 때마다 그 목록을 잊지 않고 늘려야 한다. 닿을 수 없는 곳에 두는 편이
      // 잊어버릴 수 있는 방어보다 낫다.
      allow create: if isOwner(uid)
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() >= 1
                    && request.resource.data.nickname.size() <= 30
                    && request.resource.data.ticketBalance == 0
                    && request.resource.data.ticketsIssued == 0
                    && request.resource.data.placesVisited == 0
                    && !('tier' in request.resource.data);

      // 계약서가 사용자 편집을 허용하는 여섯 필드에 blockedUserIds 를 더한다.
      // hasOnly 가 나머지를 전부 막는다 — tier, 카운터 3개, email, createdAt.
      // 차단은 값이 걸린 데이터가 아니라 본인 문서 안의 목록이라 함수를 거칠 이유가 없다.
      // 실제 가리기는 앱이 한다. 규칙은 쿼리를 심사할 뿐 결과를 걸러주지 않는다.
      // 상한이 없으면 문서가 1MB 한도까지 자라고, 그러면 프로필을 읽는 모든 화면이
      // (피드·리뷰가 작성자 정보를 여기서 비정규화해 들고 있어서) 같이 무거워진다.
      allow update: if isOwner(uid)
                    && changed().hasOnly(['nickname', 'avatarUrl', 'bio', 'followedArtistIds',
                                          'profileVisibility', 'locale', 'blockedUserIds'])
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() <= 30
                    && (!('bio' in request.resource.data)
                        || (request.resource.data.bio is string && request.resource.data.bio.size() <= 500))
                    && (!('followedArtistIds' in request.resource.data)
                        || (request.resource.data.followedArtistIds is list
                            && request.resource.data.followedArtistIds.size() <= 200))
                    && (!('blockedUserIds' in request.resource.data)
                        || (request.resource.data.blockedUserIds is list
                            && request.resource.data.blockedUserIds.size() <= 1000));

      allow delete: if false;

      // 내 지도 — 챗봇이 추천한 곳(assistant.ts 의 Suggestion) 중 본인이 담아둔 것.
      // 값이 걸린 데이터가 아니라 북마크라서 함수를 거치지 않는다. places 와 달리
      // 인증 기준 좌표가 아니다 — 좌표 형·범위만 본다. 지도 핀으로 바로 찍히는 값이라
      // NaN 이나 문자열 좌표가 들어오면 지도가 깨진다.
      match /savedPlaces/{savedPlaceId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
                      && request.resource.data.name is string
                      && request.resource.data.name != ''
                      && request.resource.data.name.size() <= 100
                      && request.resource.data.lat is number
                      && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
                      && request.resource.data.lng is number
                      && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
                      && request.resource.data.savedAt == request.time;

        // 수정 없음 — 즐겨찾기를 고치고 싶으면 지우고 다시 담는다.
        allow update: if false;
      }
    }

    // --- tickets — issueTicket 전용, 공개 여부만 본인이 토글 --------------------

    match /tickets/{ticketId} {
      // 문서 하나를 직접 읽는 경우는 공개 티켓도 허용한다 (공유 링크 대비).
      allow get: if signedIn()
                 && (resource.data.userId == request.auth.uid
                     || resource.data.visibility == 'public');

      // 목록 조회는 쿼리에 userId == uid 가 있어야만 통과한다.
      // 규칙은 필터가 아니라 쿼리 심사이므로, 조건이 빠지면 쿼리 전체가 거부된다.
      allow list: if signedIn() && resource.data.userId == request.auth.uid;

      allow create, delete: if false;
      allow update: if isOwner(resource.data.userId)
                    && changed().hasOnly(['visibility'])
                    // 값도 본다. 'x' 가 저장되면 컬렉션에도 보관함에도 안 잡혀 티켓이 사라진다.
                    && request.resource.data.visibility in ['public', 'private'];
    }

    // --- raffleEntries — enterRaffle 전용 ------------------------------------

    match /raffleEntries/{entryId} {
      allow read: if resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // --- posts — 유일한 대량 사용자 작성 컬렉션 --------------------------------

    // postShape() 은 create·update 양쪽이 쓴다 — 크기 상한이 한쪽에만 있으면
    // update 로 우회해 무제한 텍스트·이미지를 채워 넣을 수 있다.
    function postShape() {
      return request.resource.data.body is string
             && request.resource.data.body.size() <= 5000
             && (!('imageUrls' in request.resource.data)
                 || (request.resource.data.imageUrls is list
                     && request.resource.data.imageUrls.size() <= 9));
    }

    match /posts/{postId} {
      allow read: if signedIn();

      // 피드는 createdAt 내림차순이다. 값을 클라이언트가 쓰므로 서버 시각과 대조하지 않으면
      // 미래 시각을 넣어 맨 위를 영구히 점유할 수 있다. 앱은 serverTimestamp() 를 쓴다.
      // 게시판이 실제로 있는지 본다. 없으면 어느 피드 쿼리에도 걸리지 않는 글이 되고,
      // 그런 글은 작성자에게도 안 보이면서 컬렉션에는 남는다. 읽기 한 번의 값은 한다.
      allow create: if authorMatchesMe()
                    && postShape()
                    && exists(/databases/$(database)/documents/boards/$(request.resource.data.boardId))
                    && request.resource.data.likeCount == 0
                    && request.resource.data.commentCount == 0
                    && request.resource.data.createdAt == request.time;

      allow update: if isOwner(resource.data.authorId)
                    && changed().hasOnly(['body', 'imageUrls'])
                    && postShape();

      allow delete: if isOwner(resource.data.authorId);
    }

    // --- reports — 신고 접수함 (Apple 심사 가이드라인 1.2) ----------------------

    // 넣기만 하는 상자다. 신고자 본인도 못 읽는다 — 읽기를 열면 이 컬렉션이 곧
    // "누가 누구를 신고했는가" 명단이 되고, 신고 대상이 그걸 조회할 수 있게 된다.
    // 처리는 Firebase 콘솔에서 본다.
    match /reports/{reportId} {
      // hasOnly 로 정확히 이 네 필드만 — 아니면 여분 필드로 문서를 부풀릴 수 있다.
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(
                         ['reporterId', 'targetType', 'targetId', 'reason', 'createdAt'])
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.targetType in ['post', 'comment', 'review', 'photo', 'user']
                    && request.resource.data.targetId is string
                    && request.resource.data.targetId != ''
                    && request.resource.data.targetId.size() <= 128
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 500
                    && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    // --- moderationQueue — 금칙어로 격리된 글의 원문 ---------------------------

    // moderatePost·moderateReview 가 지우기 전에 원문을 여기 옮긴다. 클라이언트는 못 본다 —
    // 열면 걸러낸 욕설을 그대로 읽을 수 있는 창구가 되고, 작성자 본인에게도 마찬가지다.
    // 관리자가 콘솔에서 확인하고 오검출이면 되살린다.
    match /moderationQueue/{itemId} {
      allow read, write: if false;
    }

    // --- rateLimits — 함수 전용 일일 호출 카운터 -------------------------------

    // AI 대화·위치 인증의 하루 상한. 클라이언트는 존재조차 몰라도 된다 — 읽히면 남은
    // 횟수가 새고, 쓰이면 상한이 무의미해진다. users 문서에 두지 않는 이유는
    // consumeDailyQuota 주석에.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // --- verificationSessions — verifyLocation 전용 ---------------------------

    // 감사 로그다. 클라이언트는 sessionId 만 돌려줄 뿐 읽지도 쓰지도 않는다.
    match /verificationSessions/{sessionId} {
      allow read, write: if false;
    }

    // --- 나머지 전부 차단 ------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
