rules_version = '2';

// PINDOM Firestore 보안 규칙
//
// 현재 상태: 전면 차단. 실제 규칙은 Phase 3에서 작성한다.
// 사양은 docs/backend-contract-review.md 와 앱 레포의
// docs/reference/backend-contract.md "Write ownership" 표를 따른다.
//
// 차단으로 시작하는 이유: 테스트 모드로 열어두면 30일 뒤 조용히 닫히고,
// 그때 원인을 찾는 데 시간이 든다. 열 곳을 하나씩 여는 편이 안전하다.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
