# Node
node_modules/

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# 서비스 계정 키 — 절대 커밋 금지. 이 레포는 public.
*-firebase-adminsdk-*.json
service-account*.json
serviceAccountKey.json

# 환경 변수
.env
.env.local
.env.*.local

# 에뮬레이터가 로컬에서 Secret Manager 값을 읽는 자리
functions/.secret.local

# 빌드 산출물
functions/lib/

# 외부 API 문서 사본 — 참고용, 저장소 소유 아님
docs/api_docs/

# 에이전트 참고용 — 저장소 산출물 아님
CLAUDE.md

# functions/.env 는 Cloud Functions 파라미터용이고 비밀이 아니다 — 비밀은 Secret Manager 에
# 있다. 배포 시점 값이라 코드 리뷰에 보여야 해서 위의 .env 무시 규칙에서 되살린다.
!functions/.env
