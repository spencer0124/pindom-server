# Cloud Functions 파라미터. 비밀 아님 (OPENAI_API_KEY 등은 Secret Manager).

# 돈 걸린 호출(askAssistant·verifyLocation·issueTicket·enterRaffle·getRoute)에 이메일 인증을
# 요구할지. 이 백엔드의 비용 방어는 전부 uid 당으로 걸려 있는데 가입이 무료·무제한이라,
# 계정을 하나 더 만들면 모든 한도가 초기화된다. 이 플래그가 그 비용을 "받을 수 있는 메일
# 주소 하나" 로 올린다.
#
# false 인 이유: 앱이 가입 직후 sendEmailVerification() 을 보내기 전에 켜면 신규 가입자가
# 전부 막힌다. 앱이 준비되면 true 로 바꾸고 배포한다. 기존 테스트 계정 3개는 미인증
# 상태라, 켜기 전에 인증 처리하거나 새로 가입해야 한다.
REQUIRE_EMAIL_VERIFIED=false
