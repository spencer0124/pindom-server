rules_version = '2';

// PINDOM Cloud Storage 보안 규칙
//
// 클라이언트가 Storage 로 직접 올리고, 그 경로만 issueTicket 에 넘긴다.
// 함수를 거치면 이미지가 함수 경계를 두 번 넘을 뿐 얻는 게 없다.
//
// EXIF 제거는 앱 책임이다 (계약서 Cloud Storage 절). 서버가 파일을 손에 쥐는
// 순간이 없어 백엔드가 할 수 없고, 업로드 전 재인코딩 한 번이면 같이 떨어진다.

service firebase.storage {
  match /b/{bucket}/o {

    function ownedImage(uid) {
      return request.auth != null
             && request.auth.uid == uid
             && request.resource.contentType.matches('image/.*')
             && request.resource.size < 10 * 1024 * 1024;
    }

    // 티켓의 SDK 읽기는 소유자만 허용한다. 다른 사람은 갤러리가 제공하는 공개
    // 다운로드 URL 로 읽는다. 경로를 안다는 이유로 새 다운로드 토큰까지 가져갈
    // 수 있으면 공개→비공개 전환에서 토큰을 회전해도 보호되지 않는다.
    // 목록 조회는 모든 폴더에서 닫는다.
    match /{folder}/{uid}/{fileName} {
      allow get: if request.auth != null
                 && ((folder == 'tickets' && request.auth.uid == uid)
                     || folder in ['posts', 'avatars']);
      allow list: if false;
      allow create, update: if folder in ['tickets', 'posts', 'avatars'] && ownedImage(uid);
      allow delete: if folder in ['tickets', 'posts', 'avatars'] && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
