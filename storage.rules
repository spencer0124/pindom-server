rules_version = '2';

// PINDOM Cloud Storage 보안 규칙
//
// 클라이언트가 Storage 로 직접 올리고, 그 경로만 issueTicket 에 넘긴다.
// 함수를 거치면 이미지가 함수 경계를 두 번 넘을 뿐 얻는 게 없다.
//
// EXIF 제거는 앱 책임이다 (계약서 Cloud Storage 절). 서버가 파일을 손에 쥐는
// 순간이 없어 백엔드가 할 수 없고, 업로드 전 재인코딩 한 번이면 같이 떨어진다.

service firebase.storage {
  match /b/{bucket}/o {

    function ownedImage(uid) {
      return request.auth != null
             && request.auth.uid == uid
             && request.resource.contentType.matches('image/.*')
             && request.resource.size < 10 * 1024 * 1024;
    }

    // 파일 하나 읽기는 로그인 사용자 전체 — 티켓 사진은 갤러리에, 게시글 사진은 피드에
    // 공개되고 앱은 URL 을 문서에서 읽어온다.
    //
    // 목록 조회(list)는 닫는다. Storage 에서 read 는 get 과 list 를 함께 뜻하므로 열어두면
    // 누구나 tickets/{남의 uid}/ 를 훑어 비공개 티켓 사진까지 꺼낼 수 있다. 앱은 경로를
    // 나열할 일이 없다.
    //
    // 삭제는 write 에서 떼어낸다. 삭제 요청에는 request.resource 가 없어 ownedImage() 가
    // 평가 예외로 끝나고, 그러면 게시글을 지워도 이미지가 남는다.
    match /{folder}/{uid}/{fileName} {
      allow get: if folder in ['tickets', 'posts'] && request.auth != null;
      allow list: if false;
      allow create, update: if folder in ['tickets', 'posts'] && ownedImage(uid);
      allow delete: if folder in ['tickets', 'posts'] && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
